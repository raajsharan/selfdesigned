NODE_ENV=production
PORT=4000

# Database (change DB_PASSWORD here whenever the PostgreSQL password changes)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infrastructure_inventory
DB_USER=infra_admin
DB_PASSWORD=change-me

# Auth
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_EXPIRES_IN=12h

# Encryption (AES-256-GCM) - must be 64 hex chars (32 bytes). Back this up: stored passwords need it.
ENCRYPTION_KEY=<generate: openssl rand -hex 32>

# CORS (comma-separated; omit for localhost-only default)
CORS_ORIGIN=http://localhost:4000,http://localhost:5173

# Optional: superadmin bootstrap (creates the account on first startup if none exists)
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=<choose a strong password: 8+ chars, upper, lower, digit>

# Backup
PG_DUMP_PATH=/usr/bin/pg_dump
CSV_BACKUP_DIR=/var/backups/inventory

# Set to 1 when running behind nginx so rate limiting sees the real client IP
TRUST_PROXY=0

# Rate limits (defaults shown). Login: per IP and per account (failed attempts only). API: requests per minute per signed-in user.
# Strict: backups, password reveal and job starts, per 15 minutes. Raise only for automated tests.
# RATE_LIMIT_LOGIN=20
# RATE_LIMIT_LOGIN_ACCOUNT=10
# RATE_LIMIT_API=600
# RATE_LIMIT_STRICT=60

# The interactive API docs (/api/docs) list every endpoint, so they are hidden in production. Set to 1 to expose them.
# ENABLE_API_DOCS=0

# In production the server refuses to start with a placeholder or empty JWT_SECRET / ENCRYPTION_KEY / DB_PASSWORD.
# After the first start you can delete SUPERADMIN_PASSWORD from this file (it is only used to create the first account);
# keep this file readable by the service user only: chmod 600 backend/.env
