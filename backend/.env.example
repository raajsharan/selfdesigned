NODE_ENV=production
PORT=4000

# Database (change DB_PASSWORD here whenever the PostgreSQL password changes)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infrastructure_inventory
DB_USER=infra_admin
DB_PASSWORD=change-me

# Auth
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_EXPIRES_IN=12h

# Encryption (AES-256-GCM) - must be 64 hex chars (32 bytes). Back this up: stored passwords need it.
ENCRYPTION_KEY=<generate: openssl rand -hex 32>

# CORS (comma-separated; omit for localhost-only default)
CORS_ORIGIN=http://localhost:4000,http://localhost:5173

# Optional: superadmin bootstrap (creates the account on first startup if none exists)
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=<choose a strong password: 8+ chars, upper, lower, digit>

# Backup
PG_DUMP_PATH=/usr/bin/pg_dump
CSV_BACKUP_DIR=/var/backups/inventory

# Set to 1 when running behind nginx so rate limiting sees the real client IP
TRUST_PROXY=0

# Optional: override the login rate limit (default 20 attempts / 15 min / IP). Raise only for automated tests.
# RATE_LIMIT_LOGIN=20
